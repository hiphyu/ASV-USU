    <include>
      <name>mb_round_red_x</name>
      <pose>18.96 10.24 0.2007060266994368 0 0 0</pose>
      <uri>model://mb_round_buoy_red</uri>
      <plugin name="vrx::PolyhedraBuoyancyDrag"
        filename="libPolyhedraBuoyancyDrag.so">
        <fluid_density>1000</fluid_density>
