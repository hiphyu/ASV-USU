  <child link="mounting_thruster_left_1"/>
  <axis xyz="0.0 0.0 1.0"/>
  <limit upper="1.57" lower="-1.57" effort="1000" velocity="50"/>
</joint>

<joint name="Rigid 87" type="fixed">
  <origin xyz="-0.021215 -0.00049 0.405" rpy="0 0 0"/>
  <parent link="mounting_thruster_left_1"/>
  <child link="thruster_left_1"/>
</joint>

<joint name="propeller_left" type="continuous">
  <origin xyz="0.018938 0.001921 -0.246311" rpy="0 0 0"/>
