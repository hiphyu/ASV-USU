<link name="base_link">
  <inertial>
    <origin xyz="0.1809808327325102 -0.11753677955957842 1.3724485576316436" rpy="0 0 0"/>
    <mass value="180"/>
    <inertia ixx="400" iyy="800" izz="1000" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://catamaaran1_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      <!-- <mesh filename="package://catamaaran1_description_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/> -->
    </geometry>
    <material name="silver"/>
    <visibility_flags>9</visibility_flags>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://catamaaran1_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      <!-- <mesh filename="package://catamaaran1_description_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/> -->
    </geometry>
  </collision>
</link>

