  <!-- GPS Publisher (ROS2) -->

  <!-- <gazebo reference="Holybro_GPS_1">
    <sensor name="gps_sensor" type="gps">
      <update_rate>5</update_rate>
      <always_on>true</always_on>
      <gps/>
    </sensor>
  </gazebo> -->

  <gazebo reference="Holybro_GPS_1">
    <sensor name="gps_sensor" type="navsat">
      <update_rate>10</update_rate>
      <always_on>true</always_on>

      <navsat>
        <!-- Position noise (meters) -->
        <position_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0000045</stddev>   TS100 quad-mode: ~0.5 m
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.0000090</stddev>
            </noise>
          </vertical>
        </position_sensing>

        <!-- Velocity noise (m/s) -->
        <velocity_sensing>
          <horizontal>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.10</stddev>  <!-- TS100: 0.1 m/s -->
            </noise>
          </horizontal>
          <vertical>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>0.10</stddev>
            </noise>
          </vertical>
        </velocity_sensing>
      </navsat>
    </sensor>
  </gazebo>

