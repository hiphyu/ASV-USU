<gazebo>
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>4.7</hull_length>
      <hull_radius>0.58</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>0.6 1.03 0</point>
        <point>-1.4 1.03 0</point>
      </points>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="libSurface.so" name="vrx::Surface">
      <link_name>base_link</link_name>
      <hull_length>4.7</hull_length>
      <hull_radius>0.58</hull_radius>
      <fluid_level>0</fluid_level>
      <points>
        <point>0.6 -1.03 0</point>
        <point>-1.4 -1.03 0</point>
      </points>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-hydrodynamics-system" name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <xDotU>0.0</xDotU> <yDotV>0.0</yDotV> <nDotR>0.0</nDotR>
      <xU>-51.3</xU> <xAbsU>-72.4</xAbsU>
      <yV>-40.0</yV> <yAbsV>0.0</yAbsV>
      <zW>-100.0</zW>
      <kP>-100.0</kP> <mQ>-100.0</mQ> <nR>-600.0</nR> <nAbsR>-25.0</nAbsR>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <robot_base_frame>base_link</robot_base_frame>
      <odom_frame>/odom</odom_frame>
      <odom_topic>odometry</odom_topic>
      <dimensions>3</dimensions>
      <tf_topic>tf</tf_topic>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>propeller_left</joint_name>
      <thrust_coefficient>50.0</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.2</propeller_diameter>
      <velocity_control>true</velocity_control>
      <!-- <topic>/world/KKI/model/wamv/left/joint/cmd_thrust</topic> -->
      <!-- <odom_topic>odom</odom_topic> -->
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <joint_name>propeller_right</joint_name>
      <thrust_coefficient>50.0</thrust_coefficient>
      <fluid_density>1000</fluid_density>
      <propeller_diameter>0.2</propeller_diameter>
      <velocity_control>true</velocity_control>
      <!-- <topic>/world/KKI/model/wamv/right/joint/cmd_thrust</topic> -->
      <!-- <odom_topic>odom</odom_topic> -->
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>thruster_left</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <topic>/world/KKI/model/wamv/left/thruster/joint/cmd_pos</topic>
      <!-- <odom_topic>odom</odom_topic> -->
      <p>100000.0</p> 
      <i>0.1</i>      
      <d>1000.0</d>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>thruster_right</joint_name>
      <use_velocity_commands>true</use_velocity_commands>
      <topic>/world/KKI/model/wamv/right/thruster/joint/cmd_pos</topic>
      <!-- <odom_topic>odom</odom_topic> -->
      <p>100000.0</p> 
      <i>0.1</i>      
      <d>1000.0</d>
    </plugin>
  </gazebo>

